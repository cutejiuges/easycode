(version 1)
(deny default)
(allow process-exec process-fork)
(allow signal (target same-sandbox))
(allow sysctl-read)
(allow file-read* (literal "/") (literal "/private/var/select/sh"))
(allow file-read-metadata (path-ancestors "/workspace/project"))
(allow file-read* (subpath "/System") (subpath "/usr") (subpath "/bin") (subpath "/sbin") (subpath "/Library") (subpath "/Applications") (subpath "/opt/homebrew") (subpath "/private/etc") (subpath "/dev") (subpath "/workspace/project"))
(allow file-write* (subpath "/workspace/project") (literal "/dev/null"))
